<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>LSCC</AssemblyName>
    <Version>0.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <PackageId>LSCC</PackageId>
    <Authors>KevY</Authors>
    <Company>LSCC</Company>
    <Product>Los Santos Copchase</Product>
    <Description>Los Santos Copchase for GTA5 (RageMP)</Description>
    <Copyright>Los Santos Copchase</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <RootNamespace>LSCC</RootNamespace>
    <Configurations>Debug;Release;Debug_KevY</Configurations>
    <SignAssembly>false</SignAssembly>
    <PackageIcon>lscc.png</PackageIcon>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Client Resources\cs_packages\**" />
    <EmbeddedResource Remove="Client Resources\cs_packages\**" />
    <None Remove="Client Resources\cs_packages\**" />
    <None Include="lscc.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Remove="meta.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="meta.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CryptSharpOfficial" Version="2.1.0" />
    <PackageReference Include="Discord.Net" Version="2.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="3.1.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="3.1.1" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql.Design" Version="1.1.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Client Resources\index.js">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="References\Bootstrapper\" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Bootstrapper">
      <HintPath>References\Bootstrapper\Bootstrapper.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="rd /s /q &quot;C:\RAGEMP\server-files\dotnet\resources\LSCC&quot;&#xD;&#xA;mkdir &quot;C:\RAGEMP\server-files\dotnet\resources\LSCC&quot;&#xD;&#xA;xcopy &quot;$(OutDir)*&quot; &quot;C:\RAGEMP\server-files\dotnet\resources\LSCC&quot; /Y&#xD;&#xA;rd /s /q &quot;C:\RAGEMP\server-files\client_packages&quot;&#xD;&#xA;rmdir &quot;C:\RAGEMP\server-files\client_packages\&quot; /S /Q&#xD;&#xA;mkdir &quot;C:\RAGEMP\server-files\client_packages\&quot;&#xD;&#xA;xcopy /E &quot;Client Resources\*&quot; &quot;C:\RAGEMP\server-files\client_packages\&quot; /Y" />
  </Target>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="rd /s /q &quot;C:\RAGEMP\server-files\dotnet\resources\LSCC&quot;&#xD;&#xA;mkdir &quot;C:\RAGEMP\server-files\dotnet\resources\LSCC&quot;&#xD;&#xA;del &quot;C:\RAGEMP\server-files\dotnet\resources\LSCC\*.*&quot; /Q" />
  </Target>

</Project>
