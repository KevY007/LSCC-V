<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>RNC</AssemblyName>
    <Version>1.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <PackageId>RNC</PackageId>
    <Authors>KevY</Authors>
    <Company>KevY</Company>
    <Product>Race 'n Chase</Product>
    <Description>Race 'n Chase script for RAGE:MP. Formerly Los Santos Copchase (LSCC)</Description>
    <Copyright>Race 'n Chase</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <RootNamespace>RNC</RootNamespace>
    <Configurations>Debug;Release;Debug_KevY</Configurations>
    <SignAssembly>false</SignAssembly>
    <PackageIcon></PackageIcon>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Client Resources\cs_packages\**" />
    <EmbeddedResource Remove="Client Resources\cs_packages\**" />
    <None Remove="Client Resources\cs_packages\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="meta.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="meta.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CryptSharpOfficial" Version="2.1.0" />
    <PackageReference Include="Discord.Net" Version="2.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="3.1.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="3.1.1" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql.Design" Version="1.1.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Client Resources\index.js">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="References\Bootstrapper\" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Bootstrapper">
      <HintPath>References\Bootstrapper\Bootstrapper.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /E &quot;$(OutDir)*&quot; &quot;C:\RAGEMP\server-files\dotnet\resources\RNC\&quot; /Y&#xD;&#xA;&#xD;&#xA;xcopy /E &quot;Client Resources\*&quot; &quot;C:\RAGEMP\server-files\client_packages\&quot; /Y&#xD;&#xA;&#xD;&#xA;xcopy /E &quot;Serverside JS\*&quot; &quot;C:\RAGEMP\server-files\packages\&quot; /Y" />
  </Target>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="rd /s /q &quot;C:\RAGEMP\server-files\dotnet\resources\RNC&quot;&#xD;&#xA;mkdir &quot;C:\RAGEMP\server-files\dotnet\resources\RNC&quot;&#xD;&#xA;&#xD;&#xA;rd /s /q &quot;C:\RAGEMP\server-files\packages&quot;&#xD;&#xA;mkdir &quot;C:\RAGEMP\server-files\packages&quot;&#xD;&#xA;&#xD;&#xA;rd /s /q &quot;C:\RAGEMP\server-files\client_packages&quot;&#xD;&#xA;mkdir &quot;C:\RAGEMP\server-files\client_packages&quot;" />
  </Target>

</Project>
